{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "env": {
      "PORT": "3000",
      "NODE_ENV": "production",
      "ENABLE_RATE_LIMITING": "false",
      "ALLOWED_ORIGINS": "*",
      "UDP_TIMEOUT": "30000",
      "MAX_UDP_CONNECTIONS": "100",
      "LOG_LEVEL": "info"
    }
  }
}
